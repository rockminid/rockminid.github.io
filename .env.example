# RockMin ID — environment configuration
#
# Copy this file to `.env.local` for local development. For GitHub Pages,
# set the same names as repository secrets/variables (see the deploy workflow).
#
# NOTHING HERE IS A SERVER SECRET. Vite inlines every VITE_* variable into the
# client bundle, where anyone can read it. Firebase web API keys are designed
# to be public; they are secured by Firestore rules and by restricting the key
# to your domains in the Google Cloud console — not by hiding them.
#
# The app runs fully without any of these. Without Firebase it works in
# local-only mode: all geochemistry, every diagram, CSV batch processing,
# export and the local specimen collection still work. Only Google sign-in,
# cloud sync and cloud feedback submission are disabled.

# ---------------------------------------------------------------------------
# Deployment path
# ---------------------------------------------------------------------------
# GitHub Pages PROJECT site (https://<user>.github.io/rockmin-id/):
#   VITE_BASE_PATH="/rockmin-id/"
# GitHub Pages USER site (https://<user>.github.io/) or a custom domain:
#   VITE_BASE_PATH="/"
VITE_BASE_PATH="/"

# Absolute origin of the deployed site, no trailing slash. Used for the
# canonical link, sitemap.xml and robots.txt. Change it if you move to a
# custom domain.
VITE_SITE_URL="https://rockminid.github.io"

# ---------------------------------------------------------------------------
# Firebase (optional) — enables Google sign-in, cloud sync and feedback
# ---------------------------------------------------------------------------
# Create your own project at https://console.firebase.google.com, enable
# Google authentication and Firestore, then paste the web app config here.
# Deploy firestore.rules to that project before going live.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# Only set this if you use a NAMED (non-default) Firestore database.
# Leave empty for the standard "(default)" database.
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# ---------------------------------------------------------------------------
# AI interpretation backend (optional)
# ---------------------------------------------------------------------------
# Base URL of a server running this repo's server.ts, which holds the Gemini
# key server-side. Leave empty to use the built-in deterministic rule engine,
# which needs no network and works offline.
#
# Never put a Gemini API key in a VITE_* variable — it would ship to every
# visitor's browser.
VITE_API_BASE_URL=""

# ---------------------------------------------------------------------------
# Server-side only (used by server.ts, never exposed to the browser)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=""
PORT="3000"
