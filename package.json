{
  "name": "rockmin-id",
  "private": false,
  "version": "2.0.0",
  "description": "RockMin ID - Automated geochemical classifier and petrological analysis platform. TAS, AFM, QAPF, pyroxene/feldspar/ultramafic projections, CIPW norm, and rock/mineral matching from oxide or element compositions.",
  "license": "MIT",
  "author": "Kishan Tiwari",
  "type": "module",
  "homepage": "https://rockminid.github.io/",
  "repository": {
    "type": "git",
    "url": "https://github.com/rockminid/rockminid.github.io.git"
  },
  "keywords": [
    "geochemistry",
    "petrology",
    "mineralogy",
    "CIPW",
    "TAS",
    "QAPF",
    "AFM",
    "GEOROC",
    "classification"
  ],
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx server.ts",
    "build": "vite build",
    "build:server": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist-server/server.cjs",
    "preview": "vite preview",
    "start": "node dist-server/server.cjs",
    "clean": "rimraf dist dist-server",
    "build:apk": "bash ./build-apk.sh",
    "ingest:georoc": "node scripts/ingest-georoc.mjs",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "d3": "^7.9.0",
    "firebase": "^12.19.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.0",
    "express": "^4.21.2",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true,
    "core-js@3.50.0": true
  }
}
